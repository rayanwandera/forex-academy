# --- Frontend (safe to expose in the browser bundle) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Netlify Functions only (NEVER prefix these with VITE_, never expose to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_CALLBACK_SECRET=invent-a-long-random-string-here
# The relationship_id you chose when you did the one-time "Register Merchant"
# call in the portal (Documentation > Merchant Collection > Register Merchant).
AIRTEL_MERCHANT_RELATIONSHIP_ID=your-chosen-relationship-id
